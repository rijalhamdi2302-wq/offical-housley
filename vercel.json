{
  "installCommand": "npm install --ignore-scripts && node node_modules/esbuild/install.js && chmod +x node_modules/.bin/*",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!.*\.apk$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\.apk$",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
